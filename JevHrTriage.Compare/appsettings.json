{
  "Compare": {
    "Mode": "Mock",
    "TimeoutSeconds": 30,
    "MaxParallelCalls": 6,
    "MaxRepeats": 5,
    "ReferenceContender": "Jev 1.13",
    "Endpoints": {
      "OpenRouterDecisions": {
        "BaseUrl": "https://openrouter.ai",
        "Path": "/api/alpha/decisions",
        "AuthHeader": "Authorization",
        "AuthScheme": "Bearer",
        "ApiKeyEnvVar": "OPENROUTER_API_KEY"
      },
      "OpenRouterChat": {
        "BaseUrl": "https://openrouter.ai",
        "Path": "/api/v1/chat/completions",
        "AuthHeader": "Authorization",
        "AuthScheme": "Bearer",
        "ApiKeyEnvVar": "OPENROUTER_API_KEY"
      },
      "Foundry": {
        "BaseUrl": "",
        "Path": "/providers/microsoft/v1/systemone",
        "AuthHeader": "api-key",
        "AuthScheme": "",
        "ApiKeyEnvVar": "AZURE_FOUNDRY_API_KEY"
      },
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "Path": "/v1/systemone",
        "AuthHeader": "",
        "AuthScheme": ""
      }
    },
    "Contenders": [
      {
        "Name": "Jev 1.13",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "typesafe/jev-1.13",
        "InputPricePerMTok": 0.042,
        "Notes": "TypeSafe. The model the main demo uses."
      },
      {
        "Name": "Microsoft-Decision-1",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "microsoft/microsoft-decision-1",
        "InputPricePerMTok": 0.042,
        "Notes": "Microsoft. Post-trained from Qwen3.5-9B."
      },
      {
        "Name": "Solar Decide Flash",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "upstage/solar-decide-flash",
        "InputPricePerMTok": 0.05,
        "Notes": "Upstage. 512K context."
      },
      {
        "Name": "Liquid D1",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "liquid/d1",
        "InputPricePerMTok": 0.04,
        "Notes": "Liquid AI."
      },
      {
        "Name": "Clef Flash",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "cloudflare/clef-flash",
        "InputPricePerMTok": 0.038,
        "Notes": "Cloudflare. Open weights (Apache-2.0)."
      },
      {
        "Name": "pplx Decider 27B",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "perplexity/pplx-decider-v1.1-27b",
        "InputPricePerMTok": 0.02,
        "Notes": "Perplexity. Open weights (Apache-2.0)."
      },
      {
        "Name": "Mercury Decide (free)",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "inception/mercury-decide:free",
        "InputPricePerMTok": 0,
        "Notes": "Inception. Free route; useful for a first live run."
      },
      {
        "Name": "GPT-6 Luna Decisions",
        "Kind": "SystemOne",
        "Endpoint": "OpenRouterDecisions",
        "Model": "openai/gpt-6-luna-decisions",
        "InputPricePerMTok": 0.1,
        "Enabled": false,
        "Notes": "OpenAI. Public beta; enable to include."
      },
      {
        "Name": "Microsoft-Decision-1 (Foundry)",
        "Kind": "SystemOne",
        "Endpoint": "Foundry",
        "Model": "<your-deployment-name>",
        "InputPricePerMTok": 0.042,
        "Enabled": false,
        "Notes": "Same model on your own Azure deployment. Set Compare:Endpoints:Foundry:BaseUrl and AZURE_FOUNDRY_API_KEY."
      },
      {
        "Name": "Nimble (local Ollama)",
        "Kind": "SystemOne",
        "Endpoint": "Ollama",
        "Model": "nimble",
        "Enabled": false,
        "Notes": "Bespoke Labs, runs locally. Needs Ollama 0.35+ and `ollama pull nimble`."
      },
      {
        "Name": "GPT-5.4 nano (LLM)",
        "Kind": "ChatLlm",
        "Endpoint": "OpenRouterChat",
        "Model": "openai/gpt-5.4-nano",
        "InputPricePerMTok": 0.2,
        "OutputPricePerMTok": 1.25,
        "Notes": "General chat LLM, prompt-and-parse baseline."
      },
      {
        "Name": "Gemini 3.5 Flash-Lite (LLM)",
        "Kind": "ChatLlm",
        "Endpoint": "OpenRouterChat",
        "Model": "google/gemini-3.5-flash-lite",
        "InputPricePerMTok": 0.3,
        "OutputPricePerMTok": 2.5,
        "Notes": "General chat LLM, prompt-and-parse baseline."
      },
      {
        "Name": "Qwen3.5 9B (LLM)",
        "Kind": "ChatLlm",
        "Endpoint": "OpenRouterChat",
        "Model": "qwen/qwen3.5-9b",
        "InputPricePerMTok": 0.1,
        "OutputPricePerMTok": 0.15,
        "Notes": "The base model Microsoft-Decision-1 was trained from, used as a plain LLM."
      }
    ]
  },
  "TriageDemo": {
    "AutoRouteMinConfidence": 0.75,
    "ReviewIfCategoryGapBelow": 0.15,
    "ReviewIfMultipleTopicsAtLeast": 0.55,
    "ReviewIfMissingInfoNoulAtLeast": 0.6,
    "UrgentScoreThreshold": 1.6,
    "UrgentHighConfidenceThreshold": 0.8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
